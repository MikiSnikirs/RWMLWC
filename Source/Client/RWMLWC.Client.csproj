<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RWMLWC</AssemblyName>
    <RootNamespace>RWMLWC.Client</RootNamespace>

    <!-- Сборка кладётся сразу в папку мода. -->
    <OutputPath>../../Mod/1.7/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Понятная ошибка вместо сотни CS0246, если пути не заданы. -->
  <Target Name="CheckGamePaths" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(RimWorldDir)' == '' Or !Exists('$(RimWorldDir)/Assembly-CSharp.dll')"
           Text="Не найдена RimWorld 1.7. Задайте переменную окружения RIMWORLD_DIR (папка, где лежит Assembly-CSharp.dll). См. docs/BUILD.md." />
    <Error Condition="'$(HarmonyDll)' == '' Or !Exists('$(HarmonyDll)')"
           Text="Не найден Harmony 3. Задайте переменную окружения HARMONY_PATH (полный путь к 0Harmony.dll). См. docs/BUILD.md." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="../Shared/RWMLWC.Shared.csproj" />
    <ProjectReference Include="../Net/RWMLWC.Net.csproj" />
    <ProjectReference Include="../ServerCore/RWMLWC.ServerCore.csproj" />
  </ItemGroup>

  <!-- Multiplayer API (rwmt, MIT) — мост для модов, которые описывают синхронизацию через него (T-085).
       Сам 0MultiplayerAPI.dll кладётся в папку мода: у игрока может не быть мода, который его привозит.
       Пакет тянет за собой справочные сборки RimWorld 1.6 — они не нужны, у нас свои от 1.7. -->
  <ItemGroup>
    <PackageReference Include="RimWorld.MultiplayerAPI" Version="0.6.0" NoWarn="NU1701" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4518" ExcludeAssets="all" PrivateAssets="all" NoWarn="NU1701" />
  </ItemGroup>

  <!-- Файлы игры: только для компиляции, в папку мода не копируются. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)/Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(RimWorldDir)/com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat">
      <HintPath>$(RimWorldDir)/Waylith.UnityCompat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- 0MultiplayerAPI.dll из пакета — в папку мода (библиотечный проект пакетные сборки сам не копирует). -->
  <Target Name="CopyMultiplayerApi" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)rimworld.multiplayerapi/0.6.0/lib/net472/0MultiplayerAPI.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
