<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RWMLWC.Tests</AssemblyName>
    <RootNamespace>RWMLWC.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Тесты не зависят от клиента и файлов игры, поэтому идут в CI. -->
    <ProjectReference Include="../Shared/RWMLWC.Shared.csproj" />
    <ProjectReference Include="../Net/RWMLWC.Net.csproj" />
    <!-- Сервер: классы сессии для TST-013; TST-012 ещё и запускает его отдельным процессом. -->
    <ProjectReference Include="../Server/RWMLWC.Server.csproj" />
  </ItemGroup>
</Project>
